{
  "template_name": "AVGTemplate",
  "template_version": "1.1.0",
  "description": "通用 Ren'Py 视觉小说模板：核心框架（template_owned）与项目配置/剧情/资源（project_owned）解耦，支持开发过程中无冲突同步模板更新与多平台打包发布。",
  "template_owned": [
    "game/core/**",
    "game/api/**",
    "game/gui.rpy",
    "game/options.rpy",
    "game/screens.rpy",
    "game/fonts/**",
    "game/libs/**",
    "game/tl/None/**",
    "game/tl/japanese/common.rpy",
    "game/tl/japanese/manual.rpy",
    "game/tl/japanese/screens.rpy",
    "game/tl/japanese/template_ui.rpy",
    "game/gui/bar/**",
    "game/gui/button/**",
    "game/gui/overlay/**",
    "game/gui/phone/**",
    "game/gui/scrollbar/**",
    "game/gui/slider/**",
    "game/gui/bubble.png",
    "game/gui/confirm_choice_hover.png",
    "game/gui/confirm_choice_idle.png",
    "game/gui/confirm_frame.png",
    "game/gui/extras_panel.png",
    "game/gui/extras_panel_hover.png",
    "game/gui/frame.png",
    "game/gui/icon_*.png",
    "game/gui/log_bg.png",
    "game/gui/log_entry*.png",
    "game/gui/manual_banner.png",
    "game/gui/manual_next*.png",
    "game/gui/manual_panel.png",
    "game/gui/manual_prev*.png",
    "game/gui/menu_arrow_*.png",
    "game/gui/namebox.png",
    "game/gui/notify.png",
    "game/gui/nvl.png",
    "game/gui/pref_*.png",
    "game/gui/quickbar.png",
    "game/gui/skip.png",
    "game/gui/textbox*.png",
    "game/gui/thoughtbubble.png"
  ],
  "managed_sync_clean_dirs": [
    "game/core",
    "game/api"
  ],
  "tools_owned": [
    "tools/sync_template.ps1",
    "tools/prepare_release.ps1",
    "template.manifest.json",
    "TEMPLATE_GUIDE.md"
  ],
  "seed_only": [
    ".gitignore",
    ".vscode/settings.json",
    "game/.gitattributes",
    "game/script.rpy",
    "game/project/**",
    "game/tl/japanese/project_strings.rpy",
    "game/gui/logo.png",
    "game/gui/window_icon.png",
    "game/gui/main_menu.png",
    "game/gui/game_menu.png",
    "game/gui/extras_bg.png",
    "android-icon_background.png",
    "android-icon_foreground.png",
    "android.json",
    "project.json"
  ]
}
