# Ren'Py runtime & cache directories
/game/saves/
/game/cache/

# Compiled script files (regenerated by Ren'Py / release builds)
/game/**/*.rpyc
/game/**/*.rpymc
/game/**/*.rpyb

# Files Ren'Py can generate
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated & distribution outputs
/dialogue.tab
/dialogue.txt
/strings.json
/*-dists/
/*.keystore
/*.jks
/tmp/
