init:
    transform left_halfbody:
        xalign -0.1
        yalign 0.0

    transform right_halfbody:
        xalign 1.0
        yalign 0.0

    # 配角居中站位。
    transform npc_center:
        xalign 0.5
        yalign 0.0
        zoom 0.78
        yoffset 70

    # 配角左右自动选位（标准尺寸）。
    transform npc_left:
        xalign 0.18
        yalign 0.0
        zoom 0.70
        yoffset 160

    transform npc_right:
        xalign 0.82
        yalign 0.0
        zoom 0.70
        yoffset 160

    transform npc_center_low:
        xalign 0.5
        yalign 0.0
        zoom 0.70
        yoffset 160

    # 配角左右自动选位（放大尺寸，适合立绘比例较小的角色）。
    transform npc_left_big:
        xalign 0.18
        yalign 0.0
        zoom 0.88
        yoffset 90

    transform npc_right_big:
        xalign 0.82
        yalign 0.0
        zoom 0.88
        yoffset 90

    transform npc_center_low_big:
        xalign 0.5
        yalign 0.0
        zoom 0.88
        yoffset 90

        




